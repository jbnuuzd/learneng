{
  // LearnEng on Cloudflare Workers: API = Worker, static site = Workers Assets, DB = D1, files/audio = R2
  "name": "learneng",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "learneng", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "learneng-files" }
  ],
  "vars": {
    "GEMINI_TEXT_MODEL": "gemini-2.5-flash",
    "GEMINI_TTS_MODEL": "gemini-2.5-flash-preview-tts"
  },
  "observability": { "enabled": true }
}
