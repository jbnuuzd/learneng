{
  "name": "learneng",
  "version": "0.1.0",
  "description": "AI-powered personalised English learning platform (CEFR / IELTS) on Cloudflare Workers + D1 + R2",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply learneng --local",
    "migrate:remote": "wrangler d1 migrations apply learneng --remote",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
